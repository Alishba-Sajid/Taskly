<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginTop="5dp"
    android:fitsSystemWindows="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/color_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbTaskCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="0dp"
            app:buttonTint="@color/app_tint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="VisualLintSystemUi" />

        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/home_task_title_placeholder"
            android:textColor="@color/text_color"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/cbTaskCompleted"
            app:layout_constraintEnd_toStartOf="@id/btnEditTask"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="VisualLintSystemUi" />

        <TextView
            android:id="@+id/tvTaskDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/home_task_description_placeholder"
            android:textColor="@color/Text"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/tvTaskTitle"
            app:layout_constraintEnd_toStartOf="@id/btnEditTask"
            app:layout_constraintTop_toBottomOf="@id/tvTaskTitle" />

        <TextView
            android:id="@+id/tvTaskDueDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/Text"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tvTaskTitle"
            app:layout_constraintTop_toBottomOf="@id/tvTaskDescription" />

        <TextView
            android:id="@+id/tvTaskStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="@string/filter_in_progress"
            android:textColor="@color/app_tint"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tvTaskTitle"
            app:layout_constraintTop_toBottomOf="@id/tvTaskDueDate" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditTask"
            android:layout_width="48dp"
            android:layout_height="46dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/task_edit_icon"
            android:textColor="@color/app_tint"
            android:textSize="20sp"
            app:cornerRadius="12dp"
            app:layout_constraintEnd_toStartOf="@id/btnDeleteTask"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="VisualLintSystemUi,TouchTargetSizeCheck" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteTask"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:backgroundTint="@color/bg_tint_2"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/task_delete_icon"
            android:textColor="@color/text_2"
            android:textSize="21sp"
            app:cornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="VisualLintSystemUi,TouchTargetSizeCheck" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

